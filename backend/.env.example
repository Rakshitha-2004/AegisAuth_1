# ========================================================
# AegisAuth — Environment Configuration Template
# (Safe to share on GitHub - Copy this file to .env and fill in values)
# ========================================================
PORT=5000
SECRET_KEY=replace-with-your-secret-key
JWT_SECRET_KEY=replace-with-your-jwt-key
MONGO_URI=your-mongodb-connection-string

# Server Runtime
PORT=5000
FLASK_DEBUG=True
FRONTEND_URL=http://localhost:5173

# Cryptographic Keys (Use a secure 32+ character random string in production)
SECRET_KEY=replace-with-your-secure-secret-key-32chars
JWT_SECRET_KEY=replace-with-your-jwt-token-signing-key-32chars

# MongoDB Database Configuration
# Leave blank to use local MongoDB (127.0.0.1:27017), or provide your MongoDB Atlas URI
MONGO_URI=
MONGO_DB_NAME=aegisauth_db

# Zero-Trust Policy Decision Engine Thresholds
IMPOSSIBLE_TRAVEL_SPEED_THRESHOLD=900
BRUTE_FORCE_THRESHOLD=5
CREDENTIAL_STUFFING_THRESHOLD=3
MFA_REQUIRED_SCORE_THRESHOLD=31
QUARANTINE_SCORE_THRESHOLD=71
